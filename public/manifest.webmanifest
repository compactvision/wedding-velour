{
  "name": "Planivo",
  "short_name": "Planivo",
  "id": "/?app=planivo",
  "description": "Planification et gestion de tous vos événements, même hors ligne.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#fffaf5",
  "theme_color": "#4b2142",
  "orientation": "portrait-primary",
  "categories": ["productivity", "business", "lifestyle"],
  "icons": [
    {
      "src": "/assets/icons/icon-192.png?v=7",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512.png?v=7",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable-512.png?v=7",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Invités",
