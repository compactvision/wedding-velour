      "icons": [{ "src": "/assets/icons/icon-192.png?v=7", "sizes": "192x192" }]
    },
    {
      "name": "Commandes",
      "short_name": "Commandes",
      "url": "/orders",
      "icons": [{ "src": "/assets/icons/icon-192.png?v=7", "sizes": "192x192" }]
    }
  ]
